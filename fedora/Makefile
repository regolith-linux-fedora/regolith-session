# Generated by porting/scripts/gen-fedora-packaging.py from debian/ (regolith-session). Do not edit by hand;
# fix the generator or porting/fedora/repos.json instead.
# Track B usage (from the repo root):  make -f fedora/Makefile && sudo make -f fedora/Makefile install
# RPM usage: the spec runs the same targets with DESTDIR=%{buildroot}.

DESTDIR ?=
PREFIX ?= /usr
LIBDIR ?= $(PREFIX)/lib64
SYSCONFDIR ?= /etc
BUILDDIR ?= _fedora_build
INSTALL ?= install
CP ?= cp -a --no-preserve=ownership
PYTHON ?= python3
MESON_FLAGS ?= --buildtype=release

# Don't leak our variables into upstream sub-makes: command-line vars travel via MAKEFLAGS (MAKEOVERRIDES)
# *and* the environment (unexport). Upstream Makefiles like xrescat use `PREFIX ?= $(DESTDIR)` (BRE-010).
MAKEOVERRIDES :=
unexport PREFIX LIBDIR SYSCONFDIR BUILDDIR INSTALL CP PYTHON MESON_FLAGS

.PHONY: all build install patch
all: build

build:

.PHONY: check
check:
	@echo 'no upstream tests'

.PHONY: install-regolith-session-flashback
install-regolith-session-flashback:
	$(INSTALL) -d "$(DESTDIR)/usr/share/gnome-session/sessions"
	$(CP) usr/share/gnome-session/sessions/regolith-x11.session "$(DESTDIR)/usr/share/gnome-session/sessions/"
	$(INSTALL) -d "$(DESTDIR)/usr/share"
	$(CP) usr/share/xsessions "$(DESTDIR)/usr/share/"
	$(INSTALL) -d "$(DESTDIR)/usr/share/applications"
	$(CP) usr/share/applications/regolith-x11.desktop "$(DESTDIR)/usr/share/applications/"
	$(INSTALL) -d "$(DESTDIR)/usr/bin"
	$(CP) usr/bin/regolith-session-x11-launch "$(DESTDIR)/usr/bin/"
	$(INSTALL) -d "$(DESTDIR)/usr/bin"
	$(CP) usr/bin/regolith-session-x11 "$(DESTDIR)/usr/bin/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user"
	$(CP) usr/lib/systemd/user/regolith-x11.service "$(DESTDIR)/usr/lib/systemd/user/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user"
	$(CP) usr/lib/systemd/user/regolith-x11-failed.service "$(DESTDIR)/usr/lib/systemd/user/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user"
	$(CP) usr/lib/systemd/user/regolith-x11.target "$(DESTDIR)/usr/lib/systemd/user/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user"
	$(CP) usr/lib/systemd/user/gnome-session@regolith-x11.target.d "$(DESTDIR)/usr/lib/systemd/user/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user"
	$(CP) usr/lib/systemd/user/gnome-session-x11@regolith-x11.target "$(DESTDIR)/usr/lib/systemd/user/"
	$(INSTALL) -d "$(DESTDIR)/usr/share/themes"
	$(CP) usr/share/themes/Regolith "$(DESTDIR)/usr/share/themes/"
	$(INSTALL) -d "$(DESTDIR)/etc/xdg"
	$(CP) etc/xdg/xdg-regolith-x11 "$(DESTDIR)/etc/xdg/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user/gnome-initial-setup-first-login.service.d"
	$(CP) usr/lib/systemd/user/gnome-initial-setup-first-login.service.d/regolith-x11.conf "$(DESTDIR)/usr/lib/systemd/user/gnome-initial-setup-first-login.service.d/"
	$(INSTALL) -d "$(DESTDIR)/usr/lib/systemd/user/gnome-initial-setup-upgrade-login.service.d"
	$(CP) usr/lib/systemd/user/gnome-initial-setup-upgrade-login.service.d/regolith-x11.conf "$(DESTDIR)/usr/lib/systemd/user/gnome-initial-setup-upgrade-login.service.d/"
	$(INSTALL) -d "$(DESTDIR)/usr/share/xdg-terminal-exec"
	$(CP) usr/share/xdg-terminal-exec/regolith-xdg-terminals.list "$(DESTDIR)/usr/share/xdg-terminal-exec/"
	$(INSTALL) -Dm644 debian/regolith-session-flashback.gsettings-override "$(DESTDIR)/usr/share/glib-2.0/schemas/10_regolith-session-flashback.gschema.override"
	@$(MAKE) -f fedora/Makefile post-install

