.PHONY: install-regolith-session-flashback-ext
install-regolith-session-flashback-ext:
	$(INSTALL) -d "$(DESTDIR)/etc/xdg"
	$(CP) etc/xdg/autostart "$(DESTDIR)/etc/xdg/"
	@$(MAKE) -f fedora/Makefile post-install

.PHONY: install post-install
install: install-regolith-session-flashback install-regolith-session-sway install-regolith-session-common install-regolith-session-flashback-ext

post-install:
	@if [ -z "$(DESTDIR)" ]; then \
	  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true; \
	  for d in /usr/share/icons/*/; do [ -f "$$d/index.theme" ] && gtk-update-icon-cache -q -f "$$d" || true; done; \
	  command -v fc-cache >/dev/null && fc-cache -s >/dev/null 2>&1 || true; \
	  update-desktop-database -q /usr/share/applications 2>/dev/null || true; \
	fi

